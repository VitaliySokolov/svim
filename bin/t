#!/usr/bin/env bash
# set -x

# determine if the tmux server is running
if tmux list-sessions &>/dev/null; then
  TMUX_RUNNING=0
else
  TMUX_RUNNING=1
fi

# determine the user's current position relative tmux:
# serverless - there is no running tmux server
# attached   - the user is currently attached to the running tmux server
# detached   - the user is currently not attached to the running tmux server
T_RUNTYPE="serverless"
if [ "$TMUX_RUNNING" -eq 0 ]; then
  if [ "$TMUX" ]; then # inside tmux
    T_RUNTYPE="attached"
  else # outside tmux
    T_RUNTYPE="detached"
  fi
fi

print_line() {
  line=${1:-""}
  color=$2
  start_color=""
  end_color=""
  case "$color" in
    bold)
      start_color="\033[1m"
      end_color="\033[0m"
      ;;
    white)
      start_color="\033[37m"
      end_color="\033[0m"
      ;;
    green)
      start_color="\033[32m"
      end_color="\033[0m"
      ;;
    blue)
      start_color="\033[34m"
      end_color="\033[0m"
      ;;
    *)
      ;;
  esac
  printf "${start_color}${line}${end_color}\n"
}

# display help text with an argument
if [ "$1" = "-h" ] || [ "$1" == "--help" ]; then
  print_line
  print_line "  t - the smart tmux session manager" bold
  print_line
  print_line "  Run interactive mode" green
  print_line "      t" blue
  print_line "        ctrl-s list only tmux sessions" blue
  print_line "        ctrl-p list only projects" blue
  print_line "        ctrl-f list results from the find command" blue
  print_line
  print_line "  Go to session (matches tmux session, project, or directory)" green
  print_line "      t {name}" blue
  print_line
  print_line "  Open popup (while in tmux)" green

  if [ "$TMUX_RUNNING" -eq 0 ]; then
    T_BIND=$(tmux show-option -gvq "@t-bind")
    if [ "$T_BIND" = "" ]; then
      T_BIND="T"
    fi
    print_line "      <prefix>+${T_BIND}" blue
    print_line "        ctrl-s list only tmux sessions" blue
    print_line "        ctrl-p list only projects"  blue
    print_line "        ctrl-f list results from the find command" blue
  else
    # printf "\033[34m      start tmux server to see bindings\n" "$T_BIND"
    print_line "      start tmux server to see bindings" blue
  fi

  print_line
  print_line "  Show help" green
  print_line "      t -h" blue
  print_line "      t --help" blue
  print_line
  exit 0
fi

HOME_REPLACER=""                                          # default to a noop
echo "$HOME" | grep -E "^[a-zA-Z0-9/_.\@-]+$" &>/dev/null # chars safe to use in sed
HOME_SED_SAFE=$?
if [ $HOME_SED_SAFE -eq 0 ]; then # $HOME should be safe to use in sed
  HOME_REPLACER="s|^$HOME/|~/|"
fi

get_fzf_prompt() {
  local fzf_prompt
  local fzf_default_prompt='>  '
  if [ "$TMUX_RUNNING" -eq 0 ]; then
    fzf_prompt="$(tmux show -gqv '@t-fzf-prompt')"
  fi
  [ -n "$fzf_prompt" ] && echo "$fzf_prompt" || echo "$fzf_default_prompt"
}

PROMPT=$(get_fzf_prompt)

get_fzf_find_binding() {
  local fzf_find_binding
  local fzf_find_binding_default='ctrl-f:change-prompt(find> )+reload(find ~ -maxdepth 3 -type d)'
  if [ "$TMUX_RUNNING" -eq 0 ]; then
    fzf_find_binding="$(tmux show -gqv '@t-fzf-find-binding')"
  fi
  [ -n "$fzf_find_binding" ] && echo "$fzf_find_binding" || echo "$fzf_find_binding_default"
}

FIND_BIND=$(get_fzf_find_binding)

get_sessions_by_mru() {
  tmux list-sessions -F '#{session_last_attached} #{session_name}' | sort --numeric-sort --reverse | awk '{print $2}'
}

get_projects_results() {
  if [[ -n "$PROJECTS_DIR" ]]; then
    # PROJECTS_DIR can be list of directories like "$HOME/dir1 $HOME/dir2"
    find $PROJECTS_DIR -mindepth 1 -maxdepth 3 -name '.git' -type d -exec dirname {} \; | sed -e "$HOME_REPLACER"
  fi
}

get_fzf_results() {
  if [ "$TMUX_RUNNING" -eq 0 ]; then
    fzf_default_results="$(tmux show -gqv '@t-fzf-default-results')"
    case $fzf_default_results in
    sessions)
      get_sessions_by_mru
      ;;
    projects)
      get_projects_results
      ;;
    *)
      get_sessions_by_mru && get_projects_results # default shows both
      ;;
    esac
  else
    get_projects_results # only show projects results when outside tmux
  fi
}

fzf_border_label_default=' My Sessions '
BORDER_LABEL=${T_FZF_BORDER_LABEL:-$fzf_border_label_default}

HEADER=" ^s sessions ^x projects ^f find"
SESSION_BIND="ctrl-s:change-prompt(sessions> )+reload(tmux list-sessions -F '#S')"
PROJECTS_BIND="ctrl-x:change-prompt(projects> )+reload(find $PROJECTS_DIR -mindepth 1 -maxdepth 3 -type d -name \".git\" | sed -e \"s|/.git||\" | sed -e \"$HOME_REPLACER\")"
TAB_BIND="tab:down,btab:up"

if [ $# -eq 1 ]; then # argument provided
  if [[ -d "$1" ]]; then # is a directory
    RESULT="$1"
  elif [[ "$1" =~ ^/ ]]; then # looks like an absolute path but doesn't exist
    echo "No directory found."
    exit 1
  else # try to find it in projects
    FOUND=$(get_projects_results | grep -E "(^|/)$1$")
    if [[ -n "$FOUND" ]]; then
      RESULT="$FOUND"
    else
      echo "No directory found."
      exit 1
    fi
  fi
else # argument not provided
  case $T_RUNTYPE in
  attached)
    if [[ -z ${FZF_TMUX_OPTS+x} ]]; then
      FZF_TMUX_OPTS="-p 53%,58%"
    fi

    RESULT=$(
      (get_fzf_results) | fzf-tmux \
        --bind "$FIND_BIND" \
        --bind "$SESSION_BIND" \
        --bind "$TAB_BIND" \
        --bind "$PROJECTS_BIND" \
        --border-label "$BORDER_LABEL" \
        --header "$HEADER" \
        --no-sort \
        --prompt "$PROMPT" \
        $FZF_TMUX_OPTS
    )
    ;;
  detached)
    RESULT=$(
      (get_fzf_results) | fzf \
        --bind "$FIND_BIND" \
        --bind "$SESSION_BIND" \
        --bind "$TAB_BIND" \
        --bind "$PROJECTS_BIND" \
        --border \
        --border-label "$BORDER_LABEL" \
        --header "$HEADER" \
        --no-sort \
        --prompt "$PROMPT"
    )
    ;;
  serverless)
    RESULT=$(
      (get_fzf_results) | fzf \
        --bind "$FIND_BIND" \
        --bind "$TAB_BIND" \
        --bind "$PROJECTS_BIND" \
        --border \
        --border-label "$BORDER_LABEL" \
        --header " ^p projects ^f find" \
        --no-sort \
        --prompt "$PROMPT"
    )
    ;;
  esac
fi

if [ "$RESULT" = "" ]; then # no result
  exit 0                     # exit silently
fi

if [ $HOME_SED_SAFE -eq 0 ]; then
  RESULT=$(echo "$RESULT" | sed -e "s|^~/|$HOME/|") # get real home path back
fi

if [[ $RESULT != /* ]]; then # tmux session
  SESSION_NAME=$RESULT
elif [[ $T_SESSION_USE_GIT_ROOT == 'true' ]]; then
  GIT_ROOT=$(git -C $RESULT rev-parse --show-toplevel 2>/dev/null) && echo $GIT_ROOT >/dev/null
  if [[ $? -ne 0 ]]; then # not inside git repository
    SESSION_NAME=$(basename "$RESULT" | tr ' .:' '_')
  else # is in git repository
    BASENAME=$(basename $GIT_ROOT)
    RELATIVE_PATH=${RESULT#$GIT_ROOT}
    SEPARATOR="/"
    FORMATTED_PATH="${RELATIVE_PATH//\//$SEPARATOR}"
    SESSION_NAME=$(echo $BASENAME$FORMATTED_PATH | tr ' .:' '_')
  fi
elif [[ $T_SESSION_NAME_INCLUDE_PARENT == 'true' ]]; then
  SESSION_NAME=$(echo "$RESULT" | tr ' .:' '_' | awk -F "/" '{print $(NF-1)"/"$NF}')
else
  SESSION_NAME="[$(basename $(dirname "$RESULT") | tr ' .:' '_')]$(basename "$RESULT" | tr ' .:' '_')"
fi

if [ "$T_RUNTYPE" != "serverless" ]; then
  ESCAPED_SESSION_NAME="${SESSION_NAME//\[/\\\[}"
  ESCAPED_SESSION_NAME="${ESCAPED_SESSION_NAME//\]/\\\]}"
  SESSION=$(tmux list-sessions -F '#S' | grep "^$ESCAPED_SESSION_NAME$") # find existing session
fi

if [ "$SESSION" = "" ]; then # session is missing
  SESSION="$SESSION_NAME"
  if [ -e $RESULT/.t ]; then
    tmux new-session -d -s "$SESSION" -c "$RESULT" $RESULT/.t # create session and run .t startup script
  else
    tmux new-session -d -s "$SESSION" -c "$RESULT" # create session
  fi
fi

case $T_RUNTYPE in # attach to session
attached)
  tmux switch-client -t "$SESSION"
  ;;
detached | serverless)
  tmux attach -t "$SESSION"
  ;;
esac
